# Lu seulement par « npm run dev » (pas par le build de production).
# /api : l'application appelle sa propre adresse et le serveur de Vite
# transmet à l'API désignée par API_CIBLE (proxy dans vite.config.js).
# Plus de blocage CORS, même ouverte par l'adresse réseau ou depuis un
# téléphone sur le même Wi-Fi.
VITE_API_URL=/api

# API utilisée en développement, SANS /api à la fin.
# Ne jamais y mettre le port de Vite (5173) : le proxy se relaierait à
# lui-même et aucune requête n'atteindrait Laravel.
#
# API lancée sur ce PC (php artisan serve) :
#API_CIBLE=http://127.0.0.1:8000
# Serveur de test Hostinger :
API_CIBLE=https://toligo.wimostore.com