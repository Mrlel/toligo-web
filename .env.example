# Réglages de l'adresse de l'API Laravel (modèle, non lu par Vite).
#
# Les vrais réglages sont dans :
# - .env.production (« npm run build ») : l'application appelle directement
#   VITE_API_URL=https://toligo.wimostore.com/api ;
# - .env.development (« npm run dev ») : l'application appelle /api sur sa
#   propre adresse, et le serveur de Vite relaie vers API_CIBLE (proxy dans
#   vite.config.js). Cela marche aussi depuis un téléphone sur le même Wi-Fi,
#   sans réglage CORS.

# Adresse de l'API, terminée par /api.
VITE_API_URL=https://toligo.wimostore.com/api

# Développement seulement : serveur vers lequel Vite relaie /api (sans /api).
# La prod, ou http://127.0.0.1:8000 pour l'API lancée sur ce PC.
API_CIBLE=https://toligo.wimostore.com
